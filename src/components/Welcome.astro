---
import mikasukaLogo from "@assets/logo.svg";
---

<div class="welcome">
  <div class="logo-container">
    <img
      id="logo"
      src={mikasukaLogo.src}
      width="auto"
      height="100"
      alt="Logotipo de Mikasuka: Bicicosas"
    />
    <a href="/bicicosas/30-dias-en-bici" class="button cover"
      >Ver el calendario</a
    >
  </div>
</div>

<style>
  .welcome {
    height: 400px;
    background-size: contain;
    background-position: center;
    position: relative;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: url("/bicicosas/intro.webp");
  }

  .intro {
  }

  .logo-container {
    position: absolute;
    width: 100%;
    margin: auto;
    text-align: center;
    bottom: -100px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #logo {
    max-width: 280px;
  }

  section p {
    line-height: 1.5rem;
  }

  @media (max-width: 768px) {
    .welcome {
      background-image: url(/bicicosas/intro-square.webp);
      aspect-ratio: 1 / 1;
      width: 100%;
      background-size: cover;
      height: auto;
    }
  }
</style>
