---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
const bicicosas = (await getCollection("bicicosas")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
import { Image } from "astro:assets";
import { formatDate } from "@helpers/format-date";
---

<Layout>
  <div class="posts-list">
    {
      bicicosas.map((cosa) => (
        <article>
          <a href={`/bicicosas/${cosa.id}`}>
            <Image
              class="thumbnail"
              src={cosa.data.thumbnail}
              alt="Imagen destacada"
              width="300"
              height="200"
            />
            <div class="description">
              <h2>{cosa.data.title}</h2>
              {cosa.data.date && (
                <time>{formatDate(cosa.data.date, "readable")}</time>
              )}
              {cosa.data.description && <p>{cosa.data.description}</p>}
            </div>
          </a>
        </article>
      ))
    }
  </div>
</Layout>

<style>
  .posts-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    grid-gap: 1rem;
  }

  .thumbnail {
    object-fit: cover;
    width: 100%;
    border-top-right-radius: 6px;
    border-top-left-radius: 6px;
  }

  a {
    text-decoration: none;
    color: #262949;
    display: block;
    border: 9px double #ff92ca;
    position: relative;
    background: white;
    border-radius: 15px;
    transition: all 0.1s ease-in-out;
  }

  a:hover {
    transform: scale(1.05);
  }

  .description {
    padding: 3px 2rem 3rem;
  }

  .description > h2 {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 1rem 0 0 0;
  }

  .description > time {
    position: absolute;
    bottom: 10px;
    right: 10px;
    font-size: 0.8rem;
    color: #ff92ca;
  }
</style>
